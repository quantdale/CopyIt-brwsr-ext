{
  "manifest_version": 3,
  "name": "CopyIt",
  "version": "0.1.0",
  "description": "Compact prompt picker for CopyIt — search, filter, and copy prompts. No website injection.",
  "key": "",
  "permissions": ["nativeMessaging", "clipboardWrite"],
  "action": {
    "default_title": "CopyIt",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
